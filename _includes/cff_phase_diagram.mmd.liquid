{% assign cff_id = include.cff_id | default: page.cff_properties.id -%}
{% assign cff_element = site.cff[cff_id] -%}
{% if cff_element %}
%%{init: {
  "htmlLabels": true,
  "flowchart": {
    "wrappingWidth": {{ include.wrappingWidth | default: 260 }},
    "diagramPadding": {{ include.diagramPadding | default: 10 }},
    "padding": {{ include.padding | default: 0 }}, 
    "rankSpacing": {{ include.rankSpacing | default: 0 }},
    "nodeSpacing": {{ include.nodeSpacing | default: 0 }},
    "subGraphTitleMargin": {
      "top": 0,
      "bottom": {{ include.titleMargin | default: 0 }}
    }
  }
}}%%
flowchart TB;

    %% Process phases
{% for item in cff_element.outputs  %}
  {% for output_target in site.cff -%}
  {%- assign input_role = output_target[1].inputs | find: "id", item.id -%}
  {%- if input_role -%}
  {{output_target[0]}}("`**{{ output_target[1].title }}**`")
  {{item.id}} {% if input_role.edge_label %}-- "`{{ input_role.edge_label }}`"{% endif %}--> {{output_target[0]}}
  {% endif -%}
  {%- endfor -%}
{% endfor %}

{% for item in cff_element.inputs  %}
{% assign input_index = forloop.index %}
  {% for input_source in site.cff -%}
  {%- assign output_role = input_source[1].outputs | find: "id", item.id -%}
  {%- if output_role -%}
  {{input_source[0]}}("`**{{ input_source[1].title }}**`")
  {{input_source[0]}} --> input_{{input_index}}
  {% endif -%}
  {%- endfor -%}
{% endfor %}

    %% Process inputs
{% for item in cff_element.inputs  %}
    {{ item.id }}@{ shape: {{ item.shape | default: "doc" }}, label: "
    {%- if include.titles_only!=true -%}
    **{{ site.cff[item.id].title }}**
    {{ site.cff[item.id].description }}
    {%- else -%}
    {{ site.cff[item.id].title }}
    {%- endif %}"}
{% endfor %}
    


    %% Process flow elements

{% for item in cff_element.flow.nodes  %}
    {% if item[1].subgraph %}
        subgraph {{ item[0] }}["`*{{ item[1].title | default: item[0] }}*`"]
            {% for sub_item in item[1].subgraph  %}
            {{ sub_item }}
            {% endfor %}
        end
    {% else %}
    {{ item[0] }}@{ shape: card{% if item[1].title %}, label: "
    {%- if include.titles_only!=true -%}
    **{{ item[1].title | default: item[0] }}**
    {{ item[1].description }}
    {%- else -%}
    {{ item[1].title | default: item[0] }}
    {%- endif %}"{%endif%}}
    {% endif %}
{% endfor %}

    %% Process outputs
{% for item in cff_element.outputs  %}
    {{ item.id }}@{ shape: {{ item.shape | default: "doc" }}, label: "
    {%- if include.titles_only!=true -%}
    **{{ site.cff[item.id].title }}**
    {{ site.cff[item.id].description }}
    {%- else -%}
    {{ site.cff[item.id].title }}
    {%- endif %}"}
{% endfor %}


    %% Relations
    {% for edge in cff_element.flow.edges  %}
    {{ edge.source }} edge_{{forloop.index}}@{{ edge.link_type | default: "-->" }}{% if edge.label %}|"`{{ edge.label }}`"|{% endif %}{{ edge.target }}
    {% endfor %}

    {% for item in cff_element.inputs  %}
    {{ item.id }} {% if item.edge_label %}-- "`{{ item.edge_label }}`"{% endif %}--> flow
    {% endfor %}

    {% for item in cff_element.outputs  %}
    flow {% if item.edge_label %}-- "`{{ item.edge_label }}`"{% endif %}--> outputs_{{forloop.index}}
    {% endfor %}


    %% Structral elements
    {% for item in cff_element.inputs  %}
    subgraph input_{{forloop.index}}["`Input{% if cff_element.inputs.length > 1 %} {{forloop.index}}{% endif %}`"]
        {{ item.id }}
    end
    {% endfor %}

    subgraph flow["`{{ include.title | default: cff_element.title }}`"]
      direction {{ cff_element.flow.layout | default: "LR" }}
      {% for item in cff_element.flow.nodes  %}
      {{ item[0] }}
      {% endfor %}
    end

    {% for item in cff_element.outputs %}
    subgraph outputs_{{forloop.index}}["`Output{% if cff_element.outputs.length > 1 %} {{forloop.index}}{% endif %}`"]
        {{ item.id }}
    end
    {% endfor %}

{% else %}
flowchart LR;
    error("Rendering error, missing cff element with id `{{cff_id}}`")
{% endif %}