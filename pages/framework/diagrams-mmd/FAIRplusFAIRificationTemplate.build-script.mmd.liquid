%%{init: {
  "htmlLabels": true,
  "flowchart": {
    "wrappingWidth": 110,
    "padding": 4,
    "rankSpacing": -1,
    "diagramPadding": 0,
    "nodeSpacing": 4,
    "text-align": "left"
  }
}}%%

{% assign categories = site.data.library-interop-stories.dsm_data %}
{%- assign ft_dsm_mapping = site.data.library-interop-stories.dsm_ft_mapping %}
{%- assign ft_steps = site.data.library-interop-stories.ft_data | group_by: "ftStep" %}
flowchart LR;
{% for ft_step in ft_steps %}
    {%- assign dsm_mapping = ft_dsm_mapping | find: "ftID", ft_step.items[0].ftID %}
    {%- assign cat_info = categories | find: "categoryID", dsm_mapping.categoryID %}
    {%- assign ftStepLevel = ft_step.items[0].ftStepLevel %}
    subgraph step{{ftStepLevel}}
        direction TB
        step{{ftStepLevel}}L@{ shape: processes, label: "**{{ ftStepLevel }}.&nbsp;{{ ft_step.name }}**" } -.-
        {% for item in ft_step.items -%}
        {{ item.ftID }}@{ shape: rect, label: "{{ item.ftStepLevel }}.{{ item.ftSubStepLevel }}&nbsp;{{ item.ftSubstep }}" }
        {%- if forloop.last == false %} -.-{% endif %}
        {% endfor %} -.->
        step{{ftStepLevel}}C@{ shape: notch-rect, label: "**{{cat_info.categoryName}}**" }
    end
{% endfor %}

{% for ft_step in ft_steps -%}
{%- assign ftStepLevel = ft_step.items[0].ftStepLevel -%}
step{{ftStepLevel}}{% if forloop.last == false %} ~~~ {% endif -%}
{%- endfor %}

classDef hide fill:transparent,color:transparent,stroke:transparent,stroke-width:0px
class {% for ft_step in ft_steps -%}
{%- assign ftStepLevel = ft_step.items[0].ftStepLevel -%}
step{{ftStepLevel}}{% if forloop.last == false %},{% endif -%}
{%- endfor %} hide

classDef content-and-context fill:#1F3864,stroke:#1F3864,color:#FFFFFF,font-weight:bold
classDef representation-and-format fill:#A12964,stroke:#A12964,color:#FFFFFF,font-weight:bold
classDef hosting-environment-capabilities fill:#FF7D8D,stroke:#FF7D8D,color:#FFFFFF,font-weight:bold

{% assign level_1_ids = site.data.library-interop-stories.ft_data | where: "ftSubStepLevel", 1 | map: "ftID" -%}
{%- assign mappings_by_dsm = site.data.library-interop-stories.dsm_ft_mapping 
    | where_exp: "item", "level_1_ids contains item.ftID" 
    | group_by: "categoryID" -%}
{%- for ft_step_mappings in mappings_by_dsm -%}
class {% for ft_step_mapping in ft_step_mappings.items -%}
{%- assign ft_step = site.data.library-interop-stories.ft_data | find: "ftID", ft_step_mapping.ftID -%}
step{{ft_step.ftStepLevel}}C{% if forloop.last == false %},{% endif -%}
{%- endfor %} {{ft_step_mappings.name}}
{% endfor %}
